<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Type scale -->
    <style name="TextAppearance.Boson.Title" parent="android:TextAppearance.Material.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Boson.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Boson.Secondary" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.Boson.Section" parent="android:TextAppearance.Material.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.Boson.Readout" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Boson.Caption" parent="android:TextAppearance.Material.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.Boson.Segment" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Body</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:layout_marginEnd">@dimen/space_s</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Widget.Boson.Switch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:textAppearance">@style/TextAppearance.Boson.Body</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Boson.Button.Outlined" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:drawableTint">@color/text_secondary</item>
    </style>
    <style name="Widget.Boson.Button.Outlined.Warning">
        <item name="android:background">@drawable/bg_button_outlined_warning</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:drawableTint">@color/warning</item>
    </style>
    <style name="Widget.Boson.RailButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_rail_button</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Caption</item>
        <item name="android:textColor">@color/rail_content</item>
        <item name="android:drawableTint">@color/rail_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:maxLines">2</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Boson.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Caption</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:layout_marginEnd">@dimen/space_s</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Widget.Boson.SectionHeader" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Boson.Section</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/space_xl</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>
    <style name="Widget.Boson.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <!-- Layout helpers -->
    <style name="Boson.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Secondary</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>
    <style name="Boson.Subtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Caption</item>
        <item name="android:layout_marginTop">-6dp</item>
        <item name="android:paddingEnd">64dp</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>
    <style name="Boson.InfoKey" parent="">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Secondary</item>
    </style>
    <style name="Boson.InfoValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Boson.Readout</item>
        <item name="android:textIsSelectable">true</item>
    </style>
    <style name="Boson.InfoRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
