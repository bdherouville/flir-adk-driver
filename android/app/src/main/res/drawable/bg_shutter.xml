<?xml version="1.0" encoding="utf-8"?>
<!-- Photo: white ring around a white disc -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval"><solid android:color="@color/text_primary" /></shape>
    </item>
</ripple>
